# =============================================================================
# core-node environment
# Copy to core-node/.env and fill EVERY value. Never commit core-node/.env.
# Generate secrets with:  openssl rand -base64 36   (or -hex 32 for URL-safe)
# =============================================================================

# ---- Global -----------------------------------------------------------------
PRIMARY_DOMAIN=meenerva.io
ACME_EMAIL=admin@meenerva.io
TZ=UTC

# ---- Traefik dashboard ------------------------------------------------------
# Generate:  htpasswd -nbB admin 'YOUR_PASSWORD' | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$replace_me_with_a_real_bcrypt_hash

# ---- PostgreSQL (shared) ---------------------------------------------------
POSTGRES_SUPERUSER=meenerva_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
POSTGRES_WG_BIND_IP=10.10.0.1          # WireGuard IP of core-node; 127.0.0.1 before the mesh exists

# Per-app database passwords (consumed by postgres/initdb + the apps themselves)
KEYCLOAK_DB_PASSWORD=CHANGE_ME
N8N_DB_PASSWORD=CHANGE_ME
STALWART_DB_PASSWORD=CHANGE_ME         # only used if Stalwart uses the SQL directory backend

# ---- Redis (shared) ------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_WG_BIND_IP=10.10.0.1
# Redis logical DB index assignment (keep this table in sync as apps are added):
#   0  reserved / scratch      3  nextcloud
#   1  keycloak                4  mattermost
#   2  n8n                     5  openproject

# ---- Keycloak -------------------------------------------------------------
KEYCLOAK_HOST=id.meenerva.io
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME      # blank this after creating a real admin in the UI
KEYCLOAK_JVM_HEAP="-Xms512m -Xmx1024m"

# ---- Stalwart Mail -------------------------------------------------------
STALWART_ADMIN_HOST=mail.meenerva.io
WEBMAIL_HOST=webmail.meenerva.io
MAIL_DOMAIN=meenerva.io
STALWART_ADMIN_PASSWORD=CHANGE_ME      # seeds `admin` via STALWART_RECOVERY_ADMIN; rotate in the UI after first login

# Outbound relay / smarthost (STRONGLY recommended - see docs/05, decision D-08)
# Leave blank to send direct-to-MX (poor deliverability from Contabo IPs).
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=

# ---- Bulwark Webmail (native JMAP client; WEBMAIL_HOST set above) -------
WEBMAIL_SESSION_SECRET=CHANGE_ME                 # openssl rand -base64 36
WEBMAIL_OAUTH_ENABLED=false                      # set true after creating the Keycloak `webmail` client, then redeploy
WEBMAIL_OAUTH_CLIENT_ID=webmail                  # Keycloak client id (realm meenerva)
WEBMAIL_OAUTH_CLIENT_SECRET=                     # from the Keycloak client (leave blank until OAUTH enabled)

# ---- n8n --------------------------------------------------------------------
N8N_HOST=n8n.meenerva.io
N8N_ENCRYPTION_KEY=CHANGE_ME           # DO NOT rotate after first use; back it up
N8N_SMTP_PASSWORD=CHANGE_ME            # password of the no-reply@ Stalwart mailbox

# ---- Backups (Backblaze B2, S3-compatible) ------------------------------
B2_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_BUCKET=meenerva-backups
B2_ACCESS_KEY_ID=CHANGE_ME
B2_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=30
RESTIC_PASSWORD=CHANGE_ME              # backup encryption passphrase - store in 3 safe places
