# /etc/wireguard/wg0.conf on core-node (10.10.0.1)
# Generated by ./scripts/setup-wireguard.sh core - do not hand-edit in production.
# This example shows the intended shape.

[Interface]
Address = 10.10.0.1/24
ListenPort = 51820
PrivateKey = <core-node private key - never commit>
# Expose the private services only on the mesh interface:
# (bindings are done in docker-compose via *_WG_BIND_IP, not here)

# --- apps-node ---
[Peer]
PublicKey = <apps-node public key>
AllowedIPs = 10.10.0.2/32
Endpoint = <apps-node-public-ip>:51820
PersistentKeepalive = 25

# --- data-node (add when provisioned) ---
# [Peer]
# PublicKey = <data-node public key>
# AllowedIPs = 10.10.0.3/32
# Endpoint = <data-node-public-ip>:51820
# PersistentKeepalive = 25
