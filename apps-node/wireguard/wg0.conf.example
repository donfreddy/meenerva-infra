# /etc/wireguard/wg0.conf on apps-node (10.10.0.2)
# Generated by ./scripts/setup-wireguard.sh apps.

[Interface]
Address = 10.10.0.2/24
ListenPort = 51820
PrivateKey = <apps-node private key - never commit>

# --- core-node ---
[Peer]
PublicKey = <core-node public key>
AllowedIPs = 10.10.0.0/24
Endpoint = <core-node-public-ip>:51820
PersistentKeepalive = 25
