# Per-application environment. Copy to .env (git-ignored) or paste into the
# Portainer stack environment. Inherits the shared values from apps-node/.env.

# Shared (repeat here for a standalone Portainer stack)
PRIMARY_DOMAIN=meenerva.io
TZ=UTC
CORE_DB_HOST=10.10.0.1
CORE_DB_PORT=5432
CORE_REDIS_HOST=10.10.0.1
CORE_REDIS_PORT=6379
CORE_REDIS_PASSWORD=CHANGE_ME
CORE_SMTP_HOST=10.10.0.1
CORE_SMTP_PORT=587
MAIL_FROM=no-reply@meenerva.io
MAIL_FROM_PASSWORD=CHANGE_ME
OIDC_ISSUER=https://id.meenerva.io/realms/meenerva

# App-specific
APPNAME_DB_PASSWORD=CHANGE_ME            # from ./scripts/create-app-database.sh APPNAME
APPNAME_OIDC_SECRET=CHANGE_ME            # from the Keycloak client
