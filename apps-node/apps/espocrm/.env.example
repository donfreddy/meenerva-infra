# EspoCRM stack environment (apps-node). Copy to
# apps-node/apps/espocrm/.env and use with `make app-up NAME=espocrm`.

PRIMARY_DOMAIN=meenerva.io
TZ=UTC

ESPOCRM_DB_PASSWORD=CHANGE_ME            # from ./scripts/create-mysql-database.sh espocrm
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=CHANGE_ME         # only used on first install - see README.md
