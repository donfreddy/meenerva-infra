# DocuSeal stack environment (apps-node). Copy to
# apps-node/apps/docuseal/.env and use with `make app-up NAME=docuseal`.

PRIMARY_DOMAIN=meenerva.io
TZ=UTC

CORE_DB_HOST=10.10.0.1
CORE_DB_PORT=5432
CORE_REDIS_HOST=10.10.0.1
CORE_REDIS_PORT=6379
CORE_REDIS_PASSWORD=CHANGE_ME            # must match core-node REDIS_PASSWORD
CORE_SMTP_HOST=10.10.0.1
CORE_SMTP_PORT=587
MAIL_FROM=no-reply@meenerva.io
MAIL_FROM_PASSWORD=CHANGE_ME

DOCUSEAL_DB_PASSWORD=CHANGE_ME           # from ./scripts/create-app-database.sh docuseal
DOCUSEAL_SECRET_KEY_BASE=CHANGE_ME       # openssl rand -hex 64
