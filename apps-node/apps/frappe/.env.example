# Frappe (ERPNext + HR) stack environment (apps-node). Copy to
# apps-node/apps/frappe/.env and use with `make app-up NAME=frappe`.

PRIMARY_DOMAIN=meenerva.io
TZ=UTC

# The image tag (meenerva/frappe-erpnext-hrms:16, built by build/build.sh)
# is hardcoded in docker-compose.yml, not an env var - see the comment there
# before changing it.

# Not consumed by docker-compose.yml directly - needed for the manual
# `bench new-site` step in README.md (site creation, not a running
# container's env). Same value as MARIADB_ROOT_PASSWORD in apps-node/.env.
MARIADB_ROOT_PASSWORD=CHANGE_ME
