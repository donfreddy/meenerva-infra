# OpenProject stack environment (apps-node). Copy to
# apps-node/apps/openproject/.env and use with `make app-up NAME=openproject`.

PRIMARY_DOMAIN=meenerva.io
TZ=UTC

CORE_DB_HOST=10.10.0.1
CORE_DB_PORT=5432
CORE_SMTP_HOST=10.10.0.1
CORE_SMTP_PORT=587
MAIL_FROM=no-reply@meenerva.io
MAIL_FROM_PASSWORD=CHANGE_ME

OPENPROJECT_DB_PASSWORD=CHANGE_ME          # from ./scripts/create-app-database.sh openproject
OPENPROJECT_SECRET_KEY_BASE=CHANGE_ME      # openssl rand -hex 64 - SAME value across all containers
OPENPROJECT_ADMIN_PASSWORD=CHANGE_ME       # only used on first install/seed - see README.md
