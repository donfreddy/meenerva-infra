# =============================================================================
# apps-node environment. Copy to apps-node/.env and fill in. Never commit .env.
# =============================================================================

# ---- Global -----------------------------------------------------------------
PRIMARY_DOMAIN=meenerva.io
ACME_EMAIL=admin@meenerva.io
TZ=UTC

# ---- Traefik dashboard ------------------------------------------------------
# htpasswd -nbB admin 'YOUR_PASSWORD' | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$replace_me_with_a_real_bcrypt_hash

# ---- Shared services on core-node (over WireGuard) ------------------------
CORE_DB_HOST=10.10.0.1
CORE_DB_PORT=5432
CORE_REDIS_HOST=10.10.0.1
CORE_REDIS_PORT=6379
CORE_REDIS_PASSWORD=CHANGE_ME            # must match core-node REDIS_PASSWORD
CORE_SMTP_HOST=10.10.0.1
CORE_SMTP_PORT=587
MAIL_FROM=no-reply@meenerva.io
MAIL_FROM_PASSWORD=CHANGE_ME             # password of the no-reply@ Stalwart mailbox

# ---- Identity (Keycloak) --------------------------------------------------
OIDC_ISSUER=https://id.meenerva.io/realms/meenerva

# ---- MariaDB (shared, apps-node only - see docker-compose.yml comment) ---
MARIADB_ROOT_PASSWORD=CHANGE_ME

# ---- Backups (same bucket as core-node, different path) ------------------
# Bare FQDN, NO https:// - see the comment on this same var in
# core-node/.env.example for why.
B2_S3_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_BUCKET=meenerva-backups
B2_ACCESS_KEY_ID=CHANGE_ME
B2_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_CRON="0 3 * * *"
BACKUP_RETENTION_DAYS=30
RESTIC_PASSWORD=CHANGE_ME
BACKUP_ALERT_EMAIL=alerts@meenerva.io  # same mailbox as core-node/.env.example - must exist in Stalwart first
